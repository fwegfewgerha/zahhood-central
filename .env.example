# ---------------------------------------------------------------
# Zah Hood Central - environment
# Copy this file to `.env` and fill it in. Never commit `.env`.
# ---------------------------------------------------------------

# Where the site runs
PORT=3000
# Public base URL. Must match the Discord redirect URI exactly.
BASE_URL=http://localhost:3000

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Discord OAuth2 (Discord Developer Portal -> your app -> OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Add this exact URL under OAuth2 -> Redirects:  <BASE_URL>/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Optional: only members of this Discord server may log in.
# Requires the `guilds` scope (already requested).
DISCORD_GUILD_ID=

# The Discord user ID that is bootstrapped as GAME OWNER on first login.
# Right-click yourself in Discord with developer mode on -> Copy User ID.
OWNER_DISCORD_ID=

# --- Roblox ---
# The universe / place your game runs on (used for stat labels and deep links)
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=

# Optional Open Cloud key. Only needed if you want the site to be able to
# message live servers directly instead of waiting for their next heartbeat.
# Create at create.roblox.com -> Creator Dashboard -> Open Cloud -> API Keys
# with the `universe-messaging-service:publish` permission.
ROBLOX_OPEN_CLOUD_KEY=

# How many seconds without a heartbeat before a server is considered dead
SERVER_TIMEOUT_SECONDS=90

# --- Security ---
# Turn on ONLY when a reverse proxy (nginx, Cloudflare, Railway...) sits in
# front of the app. With it on and no proxy, anyone can spoof their IP with an
# X-Forwarded-For header and walk straight past the rate limiter.
TRUST_PROXY=0

# Set to production when deploying. Enables Secure cookies and HSTS, and makes
# the startup security check fail loudly on an insecure configuration.
# NODE_ENV=production
